@page "/"

<PageTitle>Mo's Chat</PageTitle>

<div class="flex flex-col items-center py-16 text-center">
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-[#141414] shadow-2xl">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="text-emerald-400" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            <path class="text-white" d="M8.5 11.5h7M8.5 14.5h4.5" />
        </svg>
    </div>

    <h1 class="mt-6 text-3xl font-semibold tracking-wide text-gray-100">Welcome to Mo's Chat</h1>
    <p class="mt-2 max-w-md text-sm text-gray-500">A simple AI chat assistant. Add your API key, then start a conversation.</p>

    <div class="mt-8 flex items-center gap-3">
        <NavLink href="chat" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-500">
            Start chatting
        </NavLink>
        <NavLink href="api-key" class="rounded-lg border border-white/10 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/5">
            Set API key
        </NavLink>
    </div>

    <div class="mt-12 grid w-full gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-[#141414] p-5 text-left shadow-2xl">
            <ChatIcon Class="h-5 w-5 text-emerald-400" />
            <h2 class="mt-3 text-sm font-semibold text-gray-100">Chat</h2>
            <p class="mt-1 text-xs text-gray-500">Ask questions and get answers in a clean, focused interface.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#141414] p-5 text-left shadow-2xl">
            <KeyIcon Class="h-5 w-5 text-emerald-400" />
            <h2 class="mt-3 text-sm font-semibold text-gray-100">Your key</h2>
            <p class="mt-1 text-xs text-gray-500">Bring your own API key. It stays in your browser.</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#141414] p-5 text-left shadow-2xl">
            <UsageIcon Class="h-5 w-5 text-emerald-400" />
            <h2 class="mt-3 text-sm font-semibold text-gray-100">Usage</h2>
            <p class="mt-1 text-xs text-gray-500">Keep an eye on how many tokens you're using.</p>
        </div>
    </div>
</div>
