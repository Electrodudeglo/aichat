@page "/not-found"

<PageTitle>Page Not Found</PageTitle>

<div class="flex min-h-[80vh] items-center justify-center">
    <div class="rounded-2xl border border-white/10 bg-[#141414] p-10 text-center shadow-2xl w-128">
        <h1 class="text-6xl font-bold text-emerald-400">404</h1>
        <h3 class="mt-4 text-lg font-semibold text-gray-100">Page not found</h3>
        <p class="mt-2 text-sm text-gray-500">Sorry, the page you are looking for does not exist.</p>
        <a href="/" class="mt-6 inline-block rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-500">Back to home</a>
    </div>
</div>
