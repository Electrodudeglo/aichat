@page "/usage"
@using aichat.Interfaces
@inject IChatStateService ChatState
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@implements IDisposable

<PageTitle>Usage</PageTitle>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 shadow-2xl">
    <h1 class="text-lg font-semibold text-gray-100">Usage</h1>
    <p class="mt-2 text-sm text-gray-500">Usage statistics will show up here.</p>
</div>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    <p class="mb-4 text-xs text-gray-500">Showing token usage for the <span class="text-gray-300">current session</span> only. Numbers reset when you refresh or start a new session.</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Total Prompt Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@promptTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Total Completion Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@CompletetionTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase font-semibold tracking-wide text-center text-white">Total Tokens</p>
            <div class="border rounded-2xl border-emerald-500/30 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@TotalTokens</p>
            </div>
        </div>
    </div>
</div>


<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    @{ var rows = BuildUsageRows(messages).TakeLast(6).ToList(); }

    @for (var i = 0; i < rows.Count; i++)
    {
        var row = rows[i];
        var divider = i < rows.Count - 1 ? "border-b border-white/5" : "";

        <div class="flex items-center justify-between gap-4 px-2 py-2 @divider">
            <div class="shrink-0 text-[10px] text-gray-500">@row.Timestamp.ToString("HH:mm:ss")</div>

            <div class="min-w-0 max-w-[100px] truncate text-[10px] text-gray-400">@row.Content</div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] tracking-wide text-gray-500">Prompt</span>
                <span class="text-[10px] font-semibold @row.PromptTrend.Color">@row.Usage.PromptTokens @row.PromptTrend.Arrow</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] tracking-wide text-gray-500">Completion</span>
                <span class="text-[10px] font-semibold @row.CompletionTrend.Color">@row.Usage.CompletionTokens @row.CompletionTrend.Arrow</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] tracking-wide text-gray-500">Total</span>
                <span class="text-[10px] font-semibold @row.TotalTrend.Color">@row.Usage.TotalTokens @row.TotalTrend.Arrow</span>
            </div>
        </div>
    }

</div>

@code {


    private int promptTokens = 0;

    private int CompletetionTokens = 0;

    private int TotalTokens = 0;

    private List<MessageModel> messages = new();

    private static (string Arrow, string Color) GetTrend(int current, int? previous)
    {
        if (previous is null || current == previous)
        {
            return ("", "text-gray-300");
        }

        return current > previous ? ("▲", "text-red-400") : ("▼", "text-emerald-400");
    }

    private sealed record UsageRow(DateTime Timestamp, string Content, TokenUsageModel Usage, (string Arrow, string Color) PromptTrend, (string Arrow, string Color) CompletionTrend, (string Arrow, string Color) TotalTrend);

    private static List<UsageRow> BuildUsageRows(List<MessageModel> source)
    {
        var rows = new List<UsageRow>();
        int? previousPrompt = null;
        int? previousCompletion = null;
        int? previousTotal = null;

        foreach (var message in source)
        {
            if (message.TokenUsage is not { } usage)
            {
                continue;
            }

            rows.Add(new UsageRow(
                message.Timestamp,
                message.Content,
                usage,
                GetTrend(usage.PromptTokens, previousPrompt),
                GetTrend(usage.CompletionTokens, previousCompletion),
                GetTrend(usage.TotalTokens, previousTotal)));

            previousPrompt = usage.PromptTokens;
            previousCompletion = usage.CompletionTokens;
            previousTotal = usage.TotalTokens;
        }

        return rows;
    }

    public async Task TestField()
    {
        var options = new JsonSerializerOptions(JsonSerializerDefaults.Web);
        options.Converters.Add(new JsonStringEnumConverter());

        var testMessages = await Http.GetFromJsonAsync<List<MessageModel>>("sample-data/airesponse.json", options);
        messages.AddRange(testMessages ?? []);

    }

    protected override async Task OnInitializedAsync()
    {
        ChatState.OnChange += HandleChange;
        RecalculateTokens();
        await TestField();
    }

    private void HandleChange()
    {
        RecalculateTokens();
        StateHasChanged();
    }

    private void RecalculateTokens()
    {
        promptTokens = 0;
        CompletetionTokens = 0;
        TotalTokens = 0;

        foreach (var message in ChatState.Messages)
        {
            if (message.TokenUsage is not { } usage)
            {
                continue;
            }

            promptTokens += usage.PromptTokens;
            CompletetionTokens += usage.CompletionTokens;
            TotalTokens += usage.TotalTokens;
        }
    }

    public void Dispose()
    {
        ChatState.OnChange -= HandleChange;
    }

}
