@page "/usage"
@using aichat.Interfaces
@inject IChatStateService ChatState
@implements IDisposable

<PageTitle>Usage</PageTitle>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 shadow-2xl">
    <h1 class="text-lg font-semibold text-gray-100">Usage</h1>
    <p class="mt-2 text-sm text-gray-500">Usage statistics will show up here.</p>
</div>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    <p class="mb-4 text-xs text-gray-500">Showing token usage for the <span class="text-gray-300">current session</span> only. Numbers reset when you refresh or start a new session.</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Prompt Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@promptTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Completion Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@CompletetionTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase font-semibold tracking-wide text-center text-white">Total Tokens</p>
            <div class="border rounded-2xl border-emerald-500/30 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@TotalTokens</p>
            </div>
        </div>
    </div>
</div>


<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    <div class="">
           

    </div>

</div>

@code {


    private int promptTokens = 0;

    private int CompletetionTokens = 0;

    private int TotalTokens = 0;

    private List<MessageModel> messages = new List<MessageModel> {

        new MessageModel { Role = ChatRole.Assistant, Content = "Hello", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 5, PromptTokens = 8, TotalTokens = 13 } },
        new MessageModel { Role = ChatRole.User, Content = "How are you", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "I'm doing well! How can I help you today?", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 7, PromptTokens = 10, TotalTokens = 17 } },
        new MessageModel { Role = ChatRole.User, Content = "Hello", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Hi again! What's on your mind?", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 22, PromptTokens = 15, TotalTokens = 37 } },
        new MessageModel { Role = ChatRole.User, Content = "Hello", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Always nice to hear from you. Need anything?", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 6, PromptTokens = 8, TotalTokens = 14 } },
        new MessageModel { Role = ChatRole.User, Content = "Hello", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Hey! Ready when you are.", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 18, PromptTokens = 12, TotalTokens = 30 } },
        // --- Added generic AI-style responses below ---
        new MessageModel { Role = ChatRole.User, Content = "What can you do?", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "I can help answer questions, explain concepts, and assist with coding or ideas.", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 6, PromptTokens = 8, TotalTokens = 14 } },

        new MessageModel { Role = ChatRole.User, Content = "Tell me something interesting", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Did you know honey never spoils? Archaeologists found 3,000-year-old honey still preserved.", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 20, PromptTokens = 14, TotalTokens = 34 } },

        new MessageModel { Role = ChatRole.User, Content = "That's cool", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Glad you liked it! Want another fun fact?", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 6, PromptTokens = 8, TotalTokens = 14 } },

        new MessageModel { Role = ChatRole.User, Content = "Maybe later", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "No problem. Just let me know when you're curious again.", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 12, PromptTokens = 10, TotalTokens = 22 } },

        new MessageModel { Role = ChatRole.User, Content = "Can you help me with coding?", Timestamp = DateTime.Now, Liked = false },
        new MessageModel { Role = ChatRole.Assistant, Content = "Absolutely. What language or problem are you working on?", Timestamp = DateTime.Now, Liked = false, TokenUsage = new TokenUsageModel { CompletionTokens = 10, PromptTokens = 12, TotalTokens = 22 } }
    };


    public void TestField()
    {
        ChatState.Messages.AddRange(messages);   
    }

    protected override void OnInitialized()
    {
        ChatState.OnChange += HandleChange;
        RecalculateTokens();
    }

    private void HandleChange()
    {
        RecalculateTokens();
        StateHasChanged();
    }

    private void RecalculateTokens()
    {
        promptTokens = 0;
        CompletetionTokens = 0;
        TotalTokens = 0;

        foreach (var message in ChatState.Messages)
        {
            if (message.TokenUsage is not { } usage)
            {
                continue;
            }

            promptTokens += usage.PromptTokens;
            CompletetionTokens += usage.CompletionTokens;
            TotalTokens += usage.TotalTokens;
        }
    }

    public void Dispose()
    {
        ChatState.OnChange -= HandleChange;
    }
    

    

    public class TestMessages
    {
        public string Message { get; set; } = string.Empty;
    };

}
