@page "/usage"
@using aichat.Interfaces
@inject IChatStateService ChatState
@implements IDisposable

<PageTitle>Usage</PageTitle>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 shadow-2xl">
    <h1 class="text-lg font-semibold text-gray-100">Usage</h1>
    <p class="mt-2 text-sm text-gray-500">Usage statistics will show up here.</p>
</div>

<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    <p class="mb-4 text-xs text-gray-500">Showing token usage for the <span class="text-gray-300">current session</span> only. Numbers reset when you refresh or start a new session.</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Total Prompt Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@promptTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase tracking-wide text-center text-gray-400">Total Completion Tokens</p>
            <div class="border rounded-2xl border-white/10 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@CompletetionTokens</p>
            </div>
        </div>

        <div class="w-full sm:flex-1">
            <p class="mb-2 mx-2 text-xs uppercase font-semibold tracking-wide text-center text-white">Total Tokens</p>
            <div class="border rounded-2xl border-emerald-500/30 bg-[#1C1C1C] p-6 shadow-2xl">
                <p class="text-white text-center text-2xl font-semibold">@TotalTokens</p>
            </div>
        </div>
    </div>
</div>


<div class="rounded-2xl border border-white/10 bg-[#141414] p-6 mt-4">

    @{ var rows = BuildUsageRows(messages).TakeLast(6).ToList(); }

    @for (var i = 0; i < rows.Count; i++)
    {
        var row = rows[i];
        var divider = i < rows.Count - 1 ? "border-b border-white/5" : "";

        <div class="flex items-center justify-between gap-4 px-2 py-2 @divider">
            <div class="shrink-0 text-[10px] text-gray-500">@row.Timestamp.ToString("HH:mm:ss")</div>

            <div class="min-w-0 max-w-[100px] truncate text-[10px] text-gray-400" title="@row.Content">@row.Content</div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] uppercase tracking-wide text-gray-500">Prompt</span>
                <span class="text-[10px] font-semibold @row.PromptTrend.Color">@row.Usage.PromptTokens @row.PromptTrend.Arrow</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] uppercase tracking-wide text-gray-500">Completion</span>
                <span class="text-[10px] font-semibold @row.CompletionTrend.Color">@row.Usage.CompletionTokens @row.CompletionTrend.Arrow</span>
            </div>
            <div class="flex items-center gap-1">
                <span class="text-[10px] uppercase tracking-wide text-gray-500">Total</span>
                <span class="text-[10px] font-semibold @row.TotalTrend.Color">@row.Usage.TotalTokens @row.TotalTrend.Arrow</span>
            </div>
        </div>
    }

</div>

@code {


    private int promptTokens = 0;

    private int CompletetionTokens = 0;

    private int TotalTokens = 0;

    private List<MessageModel> messages = new();

    private static (string Arrow, string Color) GetTrend(int current, int? previous)
    {
        if (previous is null || current == previous)
        {
            return ("", "text-gray-300");
        }

        return current > previous ? ("▲", "text-red-400") : ("▼", "text-emerald-400");
    }

    private sealed record UsageRow(DateTime Timestamp, string Content, TokenUsageModel Usage, (string Arrow, string Color) PromptTrend, (string Arrow, string Color) CompletionTrend, (string Arrow, string Color) TotalTrend);

    private static List<UsageRow> BuildUsageRows(List<MessageModel> source)
    {
        var rows = new List<UsageRow>();
        int? previousPrompt = null;
        int? previousCompletion = null;
        int? previousTotal = null;

        foreach (var message in source)
        {
            if (message.TokenUsage is not { } usage)
            {
                continue;
            }

            rows.Add(new UsageRow(
                message.Timestamp,
                message.Content,
                usage,
                GetTrend(usage.PromptTokens, previousPrompt),
                GetTrend(usage.CompletionTokens, previousCompletion),
                GetTrend(usage.TotalTokens, previousTotal)));

            previousPrompt = usage.PromptTokens;
            previousCompletion = usage.CompletionTokens;
            previousTotal = usage.TotalTokens;
        }

        return rows;
    }

    public void TestField()
    {
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Hello", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 50, CompletionTokens = 200, TotalTokens = 250 } }); 
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Sure! Where are you thinking of going?", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 40, CompletionTokens = 60, TotalTokens = 100 } });       
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Got it. I'd suggest a small beach town with a scenic drive - relaxed pace, a couple of good restaurants nearby.", Liked = true, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 55, CompletionTokens = 90, TotalTokens = 145 } }); 
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Pack light: swimwear, a light jacket for the evenings, sunscreen, and comfortable walking shoes.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 35, CompletionTokens = 70, TotalTokens = 105 } }); 
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Happy to help! Let me know if you'd like restaurant or hotel suggestions too.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 45, CompletionTokens = 80, TotalTokens = 125 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Look for a seafood spot right on the harbor, and a casual cafe for breakfast before the beach. Want me to find specific names?", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 60, CompletionTokens = 95, TotalTokens = 155 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Sure, here are two solid picks near the harbor.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 70, CompletionTokens = 60, TotalTokens = 130 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "For breakfast, try the little cafe two blocks up from the pier - great pastries.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 50, CompletionTokens = 110, TotalTokens = 160 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Want me to check if either place takes reservations?", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 65, CompletionTokens = 40, TotalTokens = 105 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Got it, I'll assume walk-in for now and note the times you'd prefer.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 90, CompletionTokens = 85, TotalTokens = 175 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Evenings around 7 should be quieter than the weekend rush.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 60, CompletionTokens = 50, TotalTokens = 110 } });
        messages.Add( new MessageModel { Role = Enums.ChatRoleEnum.Assistant, Content = "Here's a quick recap of the trip plan so far, with all the details pulled together.", Liked = false, Timestamp = DateTime.Now, TokenUsage = new TokenUsageModel { PromptTokens = 80, CompletionTokens = 120, TotalTokens = 200 } });
    }

    protected override void OnInitialized()
    {
        ChatState.OnChange += HandleChange;
        RecalculateTokens();
        TestField();
    }

    private void HandleChange()
    {
        RecalculateTokens();
        StateHasChanged();
    }

    private void RecalculateTokens()
    {
        promptTokens = 0;
        CompletetionTokens = 0;
        TotalTokens = 0;

        foreach (var message in ChatState.Messages)
        {
            if (message.TokenUsage is not { } usage)
            {
                continue;
            }

            promptTokens += usage.PromptTokens;
            CompletetionTokens += usage.CompletionTokens;
            TotalTokens += usage.TotalTokens;
        }
    }

    public void Dispose()
    {
        ChatState.OnChange -= HandleChange;
    }

}
