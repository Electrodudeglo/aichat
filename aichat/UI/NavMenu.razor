@using aichat.Services
@inject ChatStateService ChatState
@inject NavigationManager Navigation

<aside class="@AsideClass">
    <NavLink href="chat" Match="NavLinkMatch.All" class="@LogoRowClass" title="Mo's Chat">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            <path d="M8.5 11.5h7M8.5 14.5h4.5" />
        </svg>
        <span class="text-xl font-semibold text-white @LabelClass">Mo's Chat</span>
    </NavLink>

    <button type="button"
            @onclick="ToggleCollapsed"
            class="@ToggleButtonClass"
            aria-label="@(collapsed ? "Expand sidebar" : "Collapse sidebar")"
            title="@(collapsed ? "Expand sidebar" : "Collapse sidebar")">
        <svg xmlns="http://www.w3.org/2000/svg" class="@ChevronClass" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" />
        </svg>
    </button>

    <div class="mb-4 border-t border-white/10"></div>

    <button type="button"
            @onclick="StartNewChat"
            class="@NewChatButtonClass"
            title="New Chat">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="font-semibold text-white @LabelClass">New Chat</span>
    </button>

    <nav class="flex flex-col gap-2 font-medium tracking-wide">
        <NavLink href="chat" class="@NavItemClass" ActiveClass="bg-emerald-500/10 text-emerald-400" title="Ai Chat">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            <span class="font-semibold text-white @LabelClass">Ai Chat</span>
        </NavLink>

        <NavLink href="api-key" class="@NavItemClass" ActiveClass="bg-emerald-500/10 text-emerald-400" title="API Key">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="15" r="3.5" />
                <path d="M10.5 12.5 20 3M17 6l2 2M13.5 9.5l2 2" />
            </svg>
            <span class="font-semibold text-white @LabelClass">API Key</span>
        </NavLink>

        <NavLink href="usage" class="@NavItemClass" ActiveClass="bg-emerald-500/10 text-emerald-400" title="Usage">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 20V10M11 20V4M18 20v-7" />
            </svg>
            <span class="font-semibold text-white @LabelClass">Usage</span>
        </NavLink>
    </nav>
</aside>

@code {
    private bool collapsed;

    private void ToggleCollapsed() => collapsed = !collapsed;

    private void StartNewChat()
    {
        ChatState.Messages.Clear();
        ChatState.IsThinking = false;
        Navigation.Refresh();
        StateHasChanged();
    }

    private string AsideClass =>
        $"flex shrink-0 flex-col overflow-hidden border-r border-white/10 bg-[#141414] p-4 shadow-2xl shadow-black/60 transition-[width] duration-300 ease-in-out {(collapsed ? "w-16" : "w-56")}";

    private string LogoRowClass =>
        $"mb-4 flex items-center px-2 tracking-wide drop-shadow-sm {(collapsed ? "justify-center gap-0" : "justify-start gap-2")}";

    private string ToggleButtonClass =>
        $"mb-4 flex h-8 w-8 items-center justify-center rounded-lg text-white/70 transition-colors hover:bg-white/5 hover:text-white {(collapsed ? "self-center" : "self-end")}";

    private string ChevronClass =>
        $"h-4 w-4 shrink-0 transition-transform duration-300 ease-in-out {(collapsed ? "rotate-180" : "")}";

    private string NewChatButtonClass =>
        $"mb-4 flex items-center rounded-lg border border-white/10 px-3 py-2 text-white/80 transition-colors hover:bg-white/5 hover:text-white {(collapsed ? "justify-center gap-0" : "justify-start gap-3")}";

    private string NavItemClass =>
        $"flex items-center rounded-lg px-3 py-2 text-white/80 transition-colors hover:bg-white/5 hover:text-white {(collapsed ? "justify-center gap-0" : "justify-start gap-3")}";

    private string LabelClass =>
        $"overflow-hidden whitespace-nowrap transition-[width,opacity] duration-300 ease-in-out {(collapsed ? "w-0 opacity-0" : "w-32 opacity-100")}";
}
